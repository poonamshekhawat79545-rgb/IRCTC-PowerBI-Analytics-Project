/// Continuous full-year calendar spanning all supplied booking and travel dates. Booking date is the active relationship.
table DimDate
	lineageTag: 7b039711-19e3-5f9b-8340-98703b79ef86
	dataCategory: Time

	column date
		dataType: dateTime
		isUnique
		isKey
		isNullable: false
		formatString: dd mmm yyyy
		lineageTag: 43dcec8e-b928-5f36-8847-33f656acd2de
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: #,##0
		lineageTag: dbe4ed5a-5458-5d6c-a118-94c125a5ed4c
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		formatString: #,##0
		lineageTag: 66e1bcd9-b18c-56ad-bbc8-a030528a3a74
		summarizeBy: none
		sourceColumn: quarter

	column month_number
		dataType: int64
		formatString: #,##0
		lineageTag: 4837b55d-d34a-5410-a33a-55742275cd9d
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: a94a91c7-646c-5602-9e90-8fab2a4c9ba4
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	column year_month
		dataType: string
		lineageTag: 133feb8b-5455-5b39-a54c-e72b43050d97
		summarizeBy: none
		sourceColumn: year_month

	column weekday
		dataType: string
		lineageTag: ea5e1c83-6f18-5dc3-b971-18e71649fb8e
		summarizeBy: none
		sourceColumn: weekday
		sortByColumn: weekday_number

	column weekday_number
		dataType: int64
		formatString: #,##0
		lineageTag: 8580b509-61b6-52f8-95f4-554703018921
		summarizeBy: none
		sourceColumn: weekday_number

	column is_weekend
		dataType: int64
		formatString: #,##0
		lineageTag: db155798-78c1-508d-bd5f-d99eb9f6765d
		summarizeBy: none
		sourceColumn: is_weekend

	hierarchy Calendar
		lineageTag: 253c52e2-209e-5ba1-95a2-6749a7602de1

		level Year
			lineageTag: a0703f28-231d-4127-8bd7-3dcd433d3924
			column: year

		level Month
			lineageTag: a0d807ed-ba49-4c7d-9505-9fcf81598416
			column: year_month

		level Date
			lineageTag: c6977e68-0d89-489b-8fae-8cb434f0820b
			column: date

	partition DimDate = m
		mode: import
		source =
				let
				    // Portable snapshot: source CSV bytes embedded as GZip + Base64.
				    // No File.Contents, Web.Contents, gateway or credentials are needed.
				    EmbeddedBase64 = Text.Combine({
				        ""
				    }, ""),
				    CsvBytes = Binary.Decompress(Binary.FromText(EmbeddedBase64, BinaryEncoding.Base64), Compression.GZip),
				    Source = Csv.Document(CsvBytes, [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"date", type date},
				        {"year", Int64.Type},
				        {"quarter", Int64.Type},
				        {"month_number", Int64.Type},
				        {"month_name", type text},
				        {"year_month", type text},
				        {"weekday", type text},
				        {"weekday_number", Int64.Type},
				        {"is_weekend", Int64.Type}
				    }, "en-US")
				in
				    Typed

		annotation IRCTC_EmbeddedCsvSha256 = c2f19e2a629ec6250aa4bc4ee0c1a5595130bfdf6691c969a6c4ed405ba031c7

		annotation IRCTC_EmbeddedCsvEncoding = UTF-8 CSV; GZip; Base64; 16000-character chunks

	annotation PBI_ResultType = Table

