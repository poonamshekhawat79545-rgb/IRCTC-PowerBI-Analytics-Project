            "expression": "COALESCE ( SUM ( 'Bookings'[catering_charges_inr] ), 0 )",
            "formatString": "\"₹\" #,##0.00;(\"₹\" #,##0.00);\"₹\" 0.00",
            "displayFolder": "02 Booking mix",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "997874b4-653c-5734-9d48-ced5dd44767f"
          },
          {
            "name": "Taxes and Convenience Value",
            "expression": "COALESCE ( SUM ( 'Bookings'[taxes_and_convenience_inr] ), 0 )",
            "formatString": "\"₹\" #,##0.00;(\"₹\" #,##0.00);\"₹\" 0.00",
