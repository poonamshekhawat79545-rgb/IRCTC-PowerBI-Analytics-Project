            "lineageTag": "9cffd825-46c7-5d15-b58d-1e8cbebe5fb6"
          },
          {
            "name": "Train Metadata Conflict Records",
            "expression": "COALESCE ( SUM ( 'Bookings'[flag_train_metadata_conflict] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "03 Data quality",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "285b7805-b282-5bc0-9142-6db6a90f528a"
          },
          {
            "name": "Occupancy Conflict Records",
            "expression": "COALESCE ( SUM ( 'Bookings'[flag_train_date_occupancy_conflict] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "03 Data quality",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "f1d9ae8b-7328-5d89-90eb-eaa938c5ddfd"
          },
          {
            "name": "Delay Conflict Records",
            "expression": "COALESCE ( SUM ( 'Bookings'[flag_train_date_delay_conflict] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "03 Data quality",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "742db6be-7740-5f0d-b2c5-41ff6ec37f92"
          },
          {
            "name": "Charge Mismatch Records",
            "expression": "COALESCE ( SUM ( 'Bookings'[flag_charge_mismatch] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "03 Data quality",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "8fed793d-a0ef-5b23-8b9a-633ddecbf035"
          },
          {
            "name": "Booking Value Per Passenger",
            "expression": "DIVIDE ( [Recorded Booking Value], [Passengers] )",
            "formatString": "\"₹\" #,##0.00;(\"₹\" #,##0.00);\"₹\" 0.00",
            "displayFolder": "02 Booking mix",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "c13ec047-ff99-58a6-b0cd-cebe4c1018fd"
          },
          {
            "name": "Average Passengers Per Booking",
            "expression": "DIVIDE ( [Passengers], [Bookings] )",
            "formatString": "0.0",
            "displayFolder": "02 Booking mix",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "bfb5d7d2-a7bf-5c46-9357-160a92bdf390"
          },
          {
            "name": "Users With Multiple Selected Bookings",
            "expression": "COALESCE ( COUNTROWS ( FILTER ( VALUES ( 'Bookings'[user_id] ), CALCULATE ( COUNTROWS ( 'Bookings' ) ) > 1 ) ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "02 Booking mix",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "8d5da31f-4f19-5fa9-9561-7a7686cd3240"
          },
          {
            "name": "Base Fare Value",
            "expression": "COALESCE ( SUM ( 'Bookings'[base_fare_inr] ), 0 )",
            "formatString": "\"₹\" #,##0.00;(\"₹\" #,##0.00);\"₹\" 0.00",
            "displayFolder": "02 Booking mix",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "5d2cf310-b54d-5216-86a1-9f334dd54f6f"
          },
          {
            "name": "Tatkal Charge Value",
            "expression": "COALESCE ( SUM ( 'Bookings'[surge_tatkal_charges_inr] ), 0 )",
            "formatString": "\"₹\" #,##0.00;(\"₹\" #,##0.00);\"₹\" 0.00",
            "displayFolder": "02 Booking mix",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "06cac380-8140-574b-bce0-b361c3d9c1a5"
          },
          {
