                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\"",
                "    }, \"\"),",
                "    CsvBytes = Binary.Decompress(Binary.FromText(EmbeddedBase64, BinaryEncoding.Base64), Compression.GZip),",
                "    Source = Csv.Document(CsvBytes, [Delimiter=\",\", Columns=42, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    MissingLeadAsNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"valid_lead_time_days\"}),",
                "    Typed = Table.TransformColumnTypes(MissingLeadAsNull, {",
                "        {\"booking_id\", type text},",
                "        {\"user_id\", type text},",
                "        {\"booking_date\", type date},",
                "        {\"booking_time\", type text},",
                "        {\"travel_date\", type date},",
                "        {\"train_number\", type text},",
                "        {\"train_name\", type text},",
                "        {\"train_type\", type text},",
                "        {\"railway_zone\", type text},",
                "        {\"source_station\", type text},",
                "        {\"destination_station\", type text},",
                "        {\"route\", type text},",
                "        {\"distance_km\", Int64.Type},",
                "        {\"travel_class\", type text},",
                "        {\"booking_type\", type text},",
                "        {\"booking_channel\", type text},",
                "        {\"partner_platform\", type text},",
                "        {\"passenger_count\", Int64.Type},",
                "        {\"base_fare_inr\", Int64.Type},",
                "        {\"surge_tatkal_charges_inr\", Int64.Type},",
                "        {\"catering_charges_inr\", Int64.Type},",
                "        {\"taxes_and_convenience_inr\", Int64.Type},",
                "        {\"booking_value_inr\", Int64.Type},",
                "        {\"payment_method\", type text},",
                "        {\"booking_status\", type text},",
                "        {\"train_capacity\", Int64.Type},",
                "        {\"occupancy_percentage\", type number},",
                "        {\"on_time_delay_mins\", Int64.Type},",
                "        {\"source_row_number\", Int64.Type},",
                "        {\"booking_month\", type text},",
                "        {\"booking_weekday\", type text},",
                "        {\"booking_hour\", Int64.Type},",
                "        {\"lead_time_days\", Int64.Type},",
                "        {\"flag_invalid_chronology\", Int64.Type},",
                "        {\"valid_lead_time_days\", Int64.Type},",
                "        {\"charge_components_inr\", Int64.Type},",
                "        {\"charge_difference_inr\", Int64.Type},",
                "        {\"flag_charge_mismatch\", Int64.Type},",
                "        {\"flag_train_metadata_conflict\", Int64.Type},",
                "        {\"flag_train_date_occupancy_conflict\", Int64.Type},",
                "        {\"flag_train_date_delay_conflict\", Int64.Type},",
                "        {\"route_key\", Int64.Type}",
                "    }, \"en-US\")",
                "in",
                "    Typed"
              ]
            },
            "annotations": [
              {
                "name": "IRCTC_EmbeddedCsvSha256",
                "value": "01e05a54749d2a77096f0c3e131334cea0059028e76e97095335da08dea0b1b9"
              },
              {
                "name": "IRCTC_EmbeddedCsvEncoding",
                "value": "UTF-8 CSV; GZip; Base64; 16000-character chunks"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Bookings",
            "expression": "COALESCE ( COUNTROWS ( 'Bookings' ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "01 Core KPIs",
            "description": "Count of accepted booking records; each accepted Booking_ID is unique.",
            "lineageTag": "62fc26a0-3062-55c8-ad6b-393079ac1afb"
          },
          {
            "name": "Recorded Booking Value",
            "expression": "COALESCE ( SUM ( 'Bookings'[booking_value_inr] ), 0 )",
            "formatString": "\"₹\" #,##0.00;(\"₹\" #,##0.00);\"₹\" 0.00",
            "displayFolder": "01 Core KPIs",
            "description": "Sum of source Total_Revenue_INR, renamed recorded booking value. Includes Confirmed, RAC, Waitlisted and Cancelled records. Refunds, settlement and recognized revenue are unavailable.",
            "lineageTag": "1778983f-7f44-5f10-9319-c56fdf852f4f"
          },
          {
            "name": "Passengers",
            "expression": "COALESCE ( SUM ( 'Bookings'[passenger_count] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "01 Core KPIs",
            "description": "Sum of Passenger_Count across retained booking records, including all statuses; not observed passengers carried.",
            "lineageTag": "2f909af9-248e-5c44-829b-d0824ada2d57"
          },
          {
            "name": "Distinct Users",
            "expression": "COALESCE ( DISTINCTCOUNT ( 'Bookings'[user_id] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "01 Core KPIs",
            "description": "Distinct supplied User_ID values in the selected accepted booking population; not total registered platform users.",
            "lineageTag": "203a3bc9-9a0c-5dbc-87b5-da2bafd39ea7"
          },
          {
            "name": "Distinct Train Numbers",
            "expression": "COALESCE ( DISTINCTCOUNT ( 'Bookings'[train_number] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "01 Core KPIs",
            "description": "Count of distinct supplied Train_Number values; not trains operated or service departures. Numbers map to multiple names and routes.",
            "lineageTag": "2407de6d-35a0-54ca-a354-b8ae798b5cdb"
          },
          {
            "name": "Average Booking Value",
            "expression": "DIVIDE ( [Recorded Booking Value], [Bookings] )",
            "formatString": "\"₹\" #,##0.00;(\"₹\" #,##0.00);\"₹\" 0.00",
            "displayFolder": "01 Core KPIs",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "7c13c316-871a-5907-96bd-47b76b720bab"
          },
          {
            "name": "Mean Reported Occupancy Pct",
            "expression": "DIVIDE ( AVERAGE ( 'Bookings'[occupancy_percentage] ), 100 )",
            "formatString": "0.0%",
            "displayFolder": "01 Core KPIs",
            "description": "Arithmetic mean of Occupancy_Percentage across accepted booking records, equally weighted per booking. Not a measured train-service load factor.",
            "lineageTag": "d1b16213-1a35-5c21-a266-1f07b48dea01"
          },
          {
            "name": "Mean Record Delay Mins",
            "expression": "AVERAGE ( 'Bookings'[on_time_delay_mins] )",
            "formatString": "0.0",
            "displayFolder": "01 Core KPIs",
            "description": "Arithmetic mean of supplied On_Time_Delay_Mins over booking records. Train-date values conflict, so this is not a verified punctuality measure.",
            "lineageTag": "4be68f2b-1949-5afa-b8dc-457b6c1951cd"
          },
          {
            "name": "Cancelled Bookings",
            "expression": "CALCULATE ( [Bookings], KEEPFILTERS ( 'Bookings'[booking_status] = \"Cancelled\" ) )",
            "formatString": "#,##0",
            "displayFolder": "01 Core KPIs",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "4830c85c-524f-5e8b-978c-56f70b9c1d5c"
          },
          {
            "name": "Cancellation Rate",
            "expression": "DIVIDE ( [Cancelled Bookings], [Bookings] )",
            "formatString": "0.0%",
            "displayFolder": "01 Core KPIs",
            "description": "Cancelled accepted records divided by all accepted records. No status-history or refund data are available.",
            "lineageTag": "6ff6aaed-e958-53ff-8a46-205b6f56b56c"
          },
          {
            "name": "Confirmed Booking Value",
            "expression": "CALCULATE ( [Recorded Booking Value], KEEPFILTERS ( 'Bookings'[booking_status] = \"Confirmed\" ) )",
            "formatString": "\"₹\" #,##0.00;(\"₹\" #,##0.00);\"₹\" 0.00",
            "displayFolder": "01 Core KPIs",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "182f6b4b-a0f7-517b-a4d2-707762d7a666"
          },
          {
            "name": "Invalid Chronology Records",
            "expression": "COALESCE ( SUM ( 'Bookings'[flag_invalid_chronology] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "03 Data quality",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "126b0686-64db-50ef-ad5a-410c53c2b37c"
          },
          {
            "name": "Invalid Chronology Rate",
            "expression": "DIVIDE ( [Invalid Chronology Records], [Bookings] )",
            "formatString": "0.0%",
            "displayFolder": "03 Data quality",
            "description": "Fraction of selected booking records whose Booking_Date is after Travel_Date.",
            "lineageTag": "8888815c-2162-5ccd-b446-b256898bdda9"
          },
          {
            "name": "Valid Lead Time Records",
            "expression": "COALESCE ( COUNT ( 'Bookings'[valid_lead_time_days] ), 0 )",
            "formatString": "#,##0",
            "displayFolder": "03 Data quality",
            "description": "Count of nonblank, nonnegative lead times within the selected accepted booking cohort.",
            "lineageTag": "66c18e9b-93e6-5719-b199-80d3fb79db3f"
          },
          {
            "name": "Mean Valid Lead Time Days",
            "expression": "AVERAGE ( 'Bookings'[valid_lead_time_days] )",
            "formatString": "0.0",
            "displayFolder": "03 Data quality",
            "description": "Travel_Date minus Booking_Date in calendar days. Negative values are retained and flagged; only nonnegative values enter valid lead-time means and medians.",
            "lineageTag": "599a6a82-4f09-539d-b166-ce456670773b"
          },
          {
            "name": "Previous Month Bookings",
            "expression": "CALCULATE ( [Bookings], DATEADD ( 'DimDate'[date], -1, MONTH ) )",
            "formatString": "#,##0",
            "displayFolder": "01 Core KPIs",
            "description": "Calculated over the current selected accepted-booking population unless explicitly stated otherwise.",
            "lineageTag": "1837c97c-6178-50f4-a50f-755de22ef311"
          },
          {
            "name": "Bookings MoM Pct",
            "expression": "DIVIDE ( [Bookings] - [Previous Month Bookings], [Previous Month Bookings] )",
            "formatString": "0.0%",
            "displayFolder": "01 Core KPIs",
            "description": "Month-over-month booking-count change in DimDate context. Blank when the preceding month has no bookings.",
            "lineageTag": "a235a4f2-1159-539f-966f-9e55b37a6d71"
          },
          {
            "name": "Selected Route Value Share",
            "expression": "DIVIDE (\n        [Recorded Booking Value],\n        CALCULATE ( [Recorded Booking Value], ALLSELECTED ( 'Bookings'[route] ) )\n    )",
            "formatString": "0.0%",
            "displayFolder": "01 Core KPIs",
            "description": "Recorded value divided by value for selected routes, preserving all other filters.",
            "lineageTag": "7c3984e7-1a8a-59b2-8fbf-0079a0d0d64c"
          },
          {
            "name": "Raw Source Records",
            "expression": "20000",
            "formatString": "#,##0",
            "displayFolder": "04 Full-source reconciliation",
            "description": "Fixed full-source reconciliation control for the embedded snapshot; intentionally unaffected by report filters.",
            "lineageTag": "5d924089-bd75-5197-bbf3-c038a540842f"
          },
          {
            "name": "Exact Duplicates Removed",
            "expression": "1",
            "formatString": "#,##0",
